# Copy to .env and edit. No keys are required — LM Studio works fully offline.
# NEVER commit a real .env file (it is gitignored).
# LM Studio (default): start its local server first (see README).
LLM_BASE_URL=http://localhost:1234/v1
PROVIDER=lmstudio
# MODEL: Thomas's model in LM Studio is Qwen3.5.
# Default is qwen3.5. If LM Studio shows a fuller identifier for it,
# e.g. qwen/qwen3.5-..., copy that EXACT identifier here instead.
MODEL=qwen3.5
# Aliases also honoured: LLM_MODEL, OLLAMA_MODEL
# Ollama instead (fallback only): LLM_BASE_URL=http://localhost:11434/v1
#
# VPS Premium — premium models from your own VPS gateway (see server/).
# Your token is issued by the VPS owner. It is NOT a provider API key;
# provider keys stay on the VPS only. Leave both blank for local-only use.
# VPS_BASE_URL=https://YOUR-VPS/v1
# VPS_API_TOKEN=
#
# Online providers — all OPTIONAL. Add only the keys you want to use,
# in Settings > Secure store or here in .env. Leave the rest blank.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=       # DeepSeek — models deepseek-chat (default), deepseek-reasoner
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# New providers from the ChatLLM model list (see models.json) — reference-only,
# confirm the exact model ID in each provider's own docs before use:
# XAI_API_KEY=         # Grok (xAI) — grok-4
# MOONSHOT_API_KEY=    # Kimi (Moonshot AI) — kimi-k2
# ZHIPU_API_KEY=       # GLM (Zhipu AI) — glm-4.5
#
# Messaging tokens (optional, v1 config only — see Settings > Messaging channels):
# WHATSAPP_ACCESS_TOKEN=
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# Service tokens (optional, v1 config only):
# SLACK_BOT_TOKEN=
# GITHUB_TOKEN=
# NOTION_TOKEN=
#
# Super Admin (platform operating models): set a long random token to
# enable the Super Admin panel in the UI (👑 Super Admin). Without it,
# the admin panel is disabled. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=
#
# MOCK_MODE=1  # test the UI and tools without any model running
# PORT=8000
# HOST=127.0.0.1
