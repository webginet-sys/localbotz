# LocalBotz VPS Premium gateway — server config. Copy to .env on the VPS.
# NEVER commit a real .env, and never put these keys in the client app.
#
# 1) The token YOU issue to users. Make it long and random, e.g.:
#    python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#    Give each user this token; they paste it in the app under
#    Settings > Connectors > VPS Premium. It is NOT a provider key.
PREMIUM_API_TOKEN=
# Optional: extra tokens (comma-separated) if you want one per user.
# PREMIUM_API_TOKENS=
#
# 1b) User registration — where users sign up on this server.
#    When REGISTRATION_OPEN=true, anyone can register at the sign-up page
#    GET /register (or POST /register from the LocalBotz app): they give a
#    name + email, the server creates their workspace and issues them their
#    OWN token (shown once, stored only as a hash in data/users.json).
#    Set REGISTRATION_OPEN=false to close sign-ups — then only tokens you
#    issue by hand above work. ADMIN_TOKEN (long random) guards the admin
#    endpoints: GET /admin/users, POST /admin/users/<workspace>/disable|enable
#    (header: X-Admin-Token). REGISTRATION_DAILY_LIMIT caps new sign-ups/day.
REGISTRATION_OPEN=true
ADMIN_TOKEN=
# REGISTRATION_DAILY_LIMIT=100
#
# 2) Premium models this VPS offers (comma-separated, configurable).
#    Default: Claude Sonnet, GPT, Gemini.
#    To add newer models, add their ids here and restart the gateway,
#    e.g. PREMIUM_MODELS=claude-sonnet-4-5,gpt-4o,gpt-4o-mini,gpt-5,gemini-2.5-flash,gemini-2.5-pro
#    Routing is by model id prefix: claude-* -> Anthropic, gpt-* -> OpenAI,
#    gemini-* -> Google, deepseek-* -> DeepSeek, anything else -> OpenRouter.
#    To offer DeepSeek models, add deepseek-chat / deepseek-reasoner to
#    PREMIUM_MODELS above and set DEEPSEEK_API_KEY.
PREMIUM_MODELS=claude-sonnet-4-5,gpt-4o,gpt-4o-mini,gemini-2.5-flash,gemini-2.5-pro
#
# 3) YOUR provider API keys — only on this VPS, only in this file.
#    Fill in the ones for the models above; leave the rest blank.
#    These keys are never sent to clients and never written to logs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
#
# 4) User sign-in portal — like the Abacus flow. Users sign in at
#    GET /login with their email + the token issued at registration, see
#    their plan at GET /account ("Your free plan works in LocalBotz" +
#    Upgrade + Open LocalBotz + Sign out), and "Open LocalBotz" takes them
#    to GET /whatsapp: enter their WhatsApp number and start a chat with
#    the bot, or skip and download the app instead. Sessions live 30 days
#    (stored hashed in data/sessions.json); 5 wrong sign-ins locks that
#    email for 5 minutes. The WhatsApp chat needs a real WhatsApp Business
#    number for the bot — put its digits here (no +, e.g. 14155550123).
#    Until it is set, the WhatsApp page honestly says chat isn't set up
#    yet and offers the download instead.
# WHATSAPP_BOT_NUMBER=
#
# 5) Bind address / port. 127.0.0.1 = localhost only (put nginx in front
#    for public HTTPS access). A Tailscale IP = tailnet-only access.
# HOST=127.0.0.1
# PORT=8001
